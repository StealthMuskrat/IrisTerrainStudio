{
  "name": "iris-terrain-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 research and deterministic parity tooling for Iris Terrain Studio",
  "engines": { "node": ">=24 <25" },
  "scripts": {
